  "description": "Local document browser for md, docx, doc, odt, xlsx, xls, ods, csv, tsv, pdf, epub, fb2, html and txt files",
  "main": "folium.js",
  "bin": {
    "folium": "./folium.js"
  },
  "files": [
    "folium.js"
  ],
  "scripts": {
    "start": "node folium.js"
  },
  "keywords": [
    "document",
    "viewer",
    "browser",
    "markdown",
    "docx",
    "xlsx",
    "pdf",
    "fb2",
    "epub",
    "ebook",
    "local",
    "cli"
  ],
  "author": "Michael Veselovski",
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "express": "^4.18.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.6.0",
    "marked": "^9.0.0",
    "sanitize-html": "^2.18.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mveselovski/folium.git"
  },
